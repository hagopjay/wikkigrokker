 <Group DEF='Halos'>
  <InstancedShape DEF='HG0'><Appearance><UnlitMaterial transparency='0.5'/><BlendMode sourceColorFactor='ONE' destinationColorFactor='ONE' sourceAlphaFactor='ONE' destinationAlphaFactor='ONE'/><DepthMode depthMask='false'/><ComposedShader DEF='HG0Shader' language='GLSL'><field accessType='inputOutput' type='SFColor' name='glowColor' value='0.9412 0.9373 0.9255'/><field accessType='inputOutput' type='SFFloat' name='strength' value='0.42'/><field accessType='inputOutput' type='SFFloat' name='power' value='2.6'/><field accessType='inputOutput' type='SFFloat' name='fogRange' value='10.0'/><ShaderPart DEF='HaloVS' type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
in vec4 x3d_Vertex;
in vec3 x3d_Normal;
in mat4 x3d_InstanceMatrix;
out vec3 vN;
out vec3 vV;
void main () {
  vec4 p = x3d_ModelViewMatrix * (x3d_InstanceMatrix * x3d_Vertex);
  vN = mat3 (x3d_ModelViewMatrix) * mat3 (x3d_InstanceMatrix) * x3d_Normal;
  vV = -p.xyz;
  gl_Position = x3d_ProjectionMatrix * p;
}
]]></ShaderPart><ShaderPart DEF='GlowFS' type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
uniform vec3 glowColor;
uniform float strength;
uniform float power;
uniform float fogRange;
in vec3 vN;
in vec3 vV;
out vec4 x3d_FragColor;
void main () {
  float f = abs (dot (normalize (vN), normalize (vV)));
  float fog = clamp (1.0 - length (vV) / fogRange, 0.0, 1.0);
  float a = strength * pow (f, power) * fog;
  x3d_FragColor = vec4 (glowColor * a, a);
}
]]></ShaderPart></ComposedShader></Appearance><Sphere USE='NodeBall'/></InstancedShape>
