  <Shape DEF='Atmosphere'><Appearance><UnlitMaterial transparency='0.5'/><BlendMode sourceColorFactor='ONE' destinationColorFactor='ONE' sourceAlphaFactor='ONE' destinationAlphaFactor='ONE'/><DepthMode depthMask='false'/><ComposedShader DEF='AtmosphereShader' language='GLSL'><field accessType='inputOutput' type='SFColor' name='glowColor' value='0.53 0.71 0.94'/><field accessType='inputOutput' type='SFFloat' name='strength' value='0.55'/><field accessType='inputOutput' type='SFFloat' name='power' value='3.2'/><ShaderPart DEF='RimVS' type='VERTEX'><![CDATA[data:x-shader/x-vertex,#version 300 es
precision highp float;
uniform mat4 x3d_ProjectionMatrix;
uniform mat4 x3d_ModelViewMatrix;
in vec4 x3d_Vertex;
in vec3 x3d_Normal;
out vec3 vN;
out vec3 vV;
void main () {
  vec4 p = x3d_ModelViewMatrix * x3d_Vertex;
  vN = mat3 (x3d_ModelViewMatrix) * x3d_Normal;
  vV = -p.xyz;
  gl_Position = x3d_ProjectionMatrix * p;
}
]]></ShaderPart><ShaderPart DEF='RimFS' type='FRAGMENT'><![CDATA[data:x-shader/x-fragment,#version 300 es
precision highp float;
uniform vec3 glowColor;
uniform float strength;
uniform float power;
in vec3 vN;
in vec3 vV;
out vec4 x3d_FragColor;
void main () {
  float f = 1.0 - abs (dot (normalize (vN), normalize (vV)));
  float a = strength * pow (f, power);
  x3d_FragColor = vec4 (glowColor * a, a);
}
]]></ShaderPart></ComposedShader></Appearance><IndexedTriangleSet solid='false' index='0 97 1 1 97 98 1 98 2 2 98 99 2 99 3 3 99 100 3 100 4 4 100 101 4 101 5 5 101 102 5 102 6 6 102 103 6 103 7 7 103 104 7 104 8 8 104 105 8 105 9 9 105 106 9 106 10 10 106 107 10 107 11 11 107 108 11 108 12 12 108 109 12 109 13 13 109 110 13 110 14 14 110 111 14 111 15 15 111 112 15 112 16 16 112 113 16 113 17 17 113 114 17 114 18 18 114 115 18 115 19 19 115 116 19 116 20 20 116 117 20 117 21 21 117 118 21 118 22 22 118 119 22 119 23 23 119 120 23 120 24 24 120 121 24 121 25 25 121 122 25 122 26 26 122 123 26 123 27 27 123 124 27 124 28 28 124 125 28 125 29 29 125 126 29 126 30 30 126 127 30 127 31 31 127 128 31 128 32 32 128 129 32 129 33 33 129 130 33 130 34 34 130 131 34 131 35 35 131 132 35 132 36 36 132 133 36 133 37 37 133 134 37 134 38 38 134 135 38 135 39 39 135 136 39 136 40 40 136 137 40 137 41 41 137 138 41 138 42 42 138 139 42 139 43 43 139 140 43 140 44 44 140 141 44 141 45 45 141 142 45 142 46 46 142 143 46 143 47 47 143 144 47 144 48 48 144 145 48 145 49 49 145 146 49 146 50 50 146 147 50 147 51 51 147 148 51 148 52 52 148 149 52 149 53 53 149 150 53 150 54 54 150 151 54 151 55 55 151 152 55 152 56 56 152 153 56 153 57 57 153 154 57 154 58 58 154 155 58 155 59 59 155 156 59 156 60 60 156 157 60 157 61 61 157 158 61 158 62 62 158 159 62 159 63 63 159 160 63 160 64 64 160 161 64 161 65 65 161 162 65 162 66 66 162 163 66 163 67 67 163 164 67 164 68 68 164 165 68 165 69 69 165 166 69 166 70 70 166 167 70 167 71 71 167 168 71 168 72 72 168 169 72 169 73 73 169 170 73 170 74 74 170 171 74 171 75 75 171 172 75 172 76 76 172 173 76 173 77 77 173 174 77 174 78 78 174 175 78 175 79 79 175 176 79 176 80 80 176 177 80 177 81 81 177 178 81 178 82 82 178 179 82 179 83 83 179 180 83 180 84 84 180 181 84 181 85 85 181 182 85 182 86 86 182 183 86 183 87 87 183 184 87 184 88 88 184 185 88 185 89 89 185 186 89 186 90 90 186 187 90 187 91 91 187 188 91 188 92 92 188 189 92 189 93 93 189 